        function getCookie(name) {
            var retVal = null;

            if (document && document.cookie) {
                var cookies = document.cookie.split(';');

                retVal = altFind(cookies, function (val) {
                    return val.trim().indexOf(name + '=') === 0;
                });

                if (retVal) {
                    retVal = retVal && retVal.replace(name + '=', '').trim();
